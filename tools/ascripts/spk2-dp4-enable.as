# Build18 speaker base. Enable AUX DP4 slave in both banks.
# Same RX0/INP0 control as prior silent test; leave DP1 mono unchanged.
# DP4 timing mirrors existing master 01000107: interval7, offset1, lane1.
@codec
tone 1000 5 1638 LR
@graph
graph.intf 1
graph.port 1
graph.dma_index 3
@tone
rx 0x180 0x05
rx 0x190 0x06
swrs 0x403 0x01
swrs 0x422 0x07
swrs 0x423 0x00
swrs 0x424 0x01
swrs 0x425 0x00
swrs 0x426 0x00
swrs 0x427 0x00
swrs 0x428 0x01
swrs 0x420 0x01
swrs 0x432 0x07
swrs 0x433 0x00
swrs 0x434 0x01
swrs 0x435 0x00
swrs 0x436 0x00
swrs 0x437 0x00
swrs 0x438 0x01
swrs 0x430 0x01
mmio 0x0a610300 0x08ff0060
delay 10
rd swr 0x104c 1
mmio 0x0a610300 0x0fff0070
delay 10
rd swr 0x104c 1
every 500ms rd rx 0x180 5
every 500ms rd rx 0x400 6
every 500ms rd rx 0x500 6
every 500ms rd swr 0x104c 1
every 500ms rd swr 0x1424 3
every 500ms rd swr 0x1464 3
every 500ms rd swrs 0x420 8
every 500ms rd swrs 0x430 8
every 500ms rd wcd 0x3008 4
every 500ms rd wcd 0x30ef 2
every 500ms rd wcd 0x3128 1
every 500ms rd wcd 0x3408 8
every 500ms rd wcd 0x344e 3
every 500ms rd wcd 0x3465 3
every 500ms rd i2c34 0x00 5
every 500ms rd i2c35 0x00 5
@stop
swrs 0x420 0x00
swrs 0x430 0x00
swrs 0x403 0x00
mmio 0x0a610300 0x08ff0060
delay 10
rd swr 0x104c 1
mmio 0x0a610300 0x0fff0070
delay 10
rd swr 0x104c 1
