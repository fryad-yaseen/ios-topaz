# Selected Android RX route and SoundWire switch, for comparison with built-in ref.
@codec
tone 1000 5 3277 LR
rx 0x180 0x70
rx 0x190 0x08
wcd 0x3409 0x0c
@graph
swrs 0x103 0x01
swrs 0x203 0x00
swrs 0x403 0x00
swr 0x1044 0x02
@tone
every 50ms rd rx 0x400 8
every 50ms rd swr 0x1124 2
@stop
rd i2c34 0x03 2
rd i2c35 0x03 2
