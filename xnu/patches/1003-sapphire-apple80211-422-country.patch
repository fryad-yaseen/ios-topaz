From 19b22025fbdc4a0e8da8b1b34de6194ba229e245 Mon Sep 17 00:00:00 2001
From: x <x@x>
Date: Thu, 22 Oct 2026 21:41:46 +0300
Subject: [PATCH] sapphire 1003: Apple80211: accept request 422, keep the
 country code

iOS 16.7.16's wifid sets 422 (no data) right before every join and stops when it is refused (DISASSOCIATE, 422 REFUSED, no ASSOCIATE; Settings: no available channel). HackiOS ran 16.5. wifid also sets and reads COUNTRY_CODE (51): keep what it sets and give it back.
---
 bsd/dev/redwood_apple80211.c | 20 ++++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/bsd/dev/redwood_apple80211.c b/bsd/dev/redwood_apple80211.c
index e2674ee..0cf467b 100644
--- a/bsd/dev/redwood_apple80211.c
+++ b/bsd/dev/redwood_apple80211.c
@@ -285,6 +285,8 @@ give_network(const struct apple80211req *request, const struct redwood_sta_bss *
 
 /* ---- get ---------------------------------------------------------------------------------------------- */
 
+static char country_code[3];
+
 static int
 get(struct apple80211req *request)
 {
@@ -292,6 +294,8 @@ get(struct apple80211req *request)
 	int error = 0;
 
 	switch (request->req_type) {
+	case 51:                                /* the country code, once wifid has set one */
+		return country_code[0] == 0 ? EOPNOTSUPP : give(request, country_code, 3);
 	case 43:
 	case 44: {                              /* the driver's and the hardware's name: the text alone, in 256 bytes */
 		static const char name[256] = "redwood: ath11k for the WCN6750";
@@ -589,6 +593,22 @@ set(const struct apple80211req *request, char *said, size_t said_size)
 	}
 	case 10:
 		return set_scan(request, said, said_size);
+	case 51: {                              /* the country code wifid settled on: kept, read back by 51 */
+		struct {
+			uint32_t version;
+			char code[4];
+		} asked;
+		int error;
+
+		if (request->req_len < sizeof(asked) || (error = copyin(request->req_data, &asked, sizeof(asked))) != 0) {
+			return request->req_len < sizeof(asked) ? EINVAL : error;
+		}
+		memcpy(country_code, asked.code, 3);
+		snprintf(said, said_size, " (country %.3s)", country_code);
+		return 0;
+	}
+	case 422:                               /* asked of iOS 16.7's wifid before every join, without data */
+		return request->req_len == 0 ? 0 : EOPNOTSUPP;
 	default:
 		return EOPNOTSUPP;
 	}
-- 
