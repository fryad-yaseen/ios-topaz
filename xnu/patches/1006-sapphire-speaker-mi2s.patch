From 3331f36c87a18c138a66dfe2b41c9b1d9ed2b653 Mon Sep 17 00:00:00 2001
From: fryad-yaseen <fryadyazeez@gmail.com>
Date: Fri, 23 Oct 2026 10:34:01 +0300
Subject: [PATCH] sapphire: add gated experimental MI2S AudioReach route

Select I2S_SINK on primary LPI I2S when sapphire_mi2s=1, or secondary when =2, vote the matching PRM IBIT clock, configure LPI TLMM pins, and start the existing sapphire amp after the graph. Keep codec DMA as the default. Attenuate PCM on the bypass path because RX macro volume no longer applies.

Hardware caveat: FourSemi lists FS1815VN as analog input (https://www.foursemi.com/article_168.html). The extracted sapphire PAL profile selects CODEC_DMA-LPAIF_RXTX-RX-1 for speaker, so there is no evidence either MI2S bus reaches the installed amps. This route is an opt-in diagnostic, not a validated speaker fix.

IDs and wire format: Linux audioreach.h and q6prm.h; pin mux: sapphire base02.dts and Linux pinctrl-lpass-lpi.h.
---
 iokit/Kernel/arm/TopazAudio.cpp | 156 ++++++++++++++++++++++++++------
 1 file changed, 129 insertions(+), 27 deletions(-)

diff --git a/iokit/Kernel/arm/TopazAudio.cpp b/iokit/Kernel/arm/TopazAudio.cpp
index 1ffaa4c..e825f44 100644
--- a/iokit/Kernel/arm/TopazAudio.cpp
+++ b/iokit/Kernel/arm/TopazAudio.cpp
@@ -1384,6 +1384,41 @@ static const uint16_t rx_stock[][2] = {
 
 static int vol_db = -30;
 static bool codec_up, ports_up, amp_init;
+static uint32_t sapphire_mi2s;
+
+/* q6prm.h: PRI/SEC_MI2S_IBIT. 48 kHz, two 16-bit slots = 1.536 MHz. */
+#define SAPPHIRE_PRI_MI2S_IBIT 0x100u
+#define SAPPHIRE_SEC_MI2S_IBIT 0x102u
+#define SAPPHIRE_MI2S_BCLK     1536000u
+
+static bool
+sapphire_mi2s_prepare(void)
+{
+	/* base02.dts LPI TLMM: I2S1 gpio6..9 func2; I2S2 gpio10..13
+	 * func1 on SCK/WS, func2 on SD0/SD1. pinctrl-lpass-lpi.h defines
+	 * mux [5:2], 8 mA drive [8:6], output enable [9], pull [1:0]. */
+	const uint32_t first = sapphire_mi2s == 1 ? 6u : 10u;
+	const uint32_t funcs[2][4] = { { 2, 2, 2, 2 }, { 1, 1, 2, 2 } };
+	const uint32_t clk = sapphire_mi2s == 1 ? SAPPHIRE_PRI_MI2S_IBIT : SAPPHIRE_SEC_MI2S_IBIT;
+	uint32_t dw[9] = { 2, 0x0800102C, 20, 0, 1, clk, SAPPHIRE_MI2S_BCLK, 1, 0 };
+	bool ok = prm(dw, 9);
+	LOG("t=%u.%03u MI2S%u PRM IBIT id=0x%x rate=%u: %s", T, sapphire_mi2s, clk,
+	    SAPPHIRE_MI2S_BCLK, ok ? "OK" : "FAILED");
+	if (!ok) return false;
+	for (uint32_t i = 0; i < 4; i++) {
+		uint32_t pa = LPI_TLMM + (first + i) * 0x1000u;
+		uint32_t old = lr(pa);
+		uint32_t cfg = (old & ~0x3FFu) | 0x2C0u | (funcs[sapphire_mi2s - 1][i] << 2);
+		lw(pa + 4, 2); /* output high before enabling the output pin */
+		lw(pa, cfg);
+		uint32_t got = lr(pa);
+		LOG("t=%u.%03u MI2S%u LPI gpio%u func%u cfg=%08x read=%08x", T,
+		    sapphire_mi2s, first + i, funcs[sapphire_mi2s - 1][i], cfg, got);
+		if (got != cfg) ok = false;
+	}
+	LOG("t=%u.%03u MI2S%u pins: %s", T, sapphire_mi2s, ok ? "OK" : "FAILED");
+	return ok;
+}
 
 /*
  * Once per boot, after SPF is ready: L14 (WCD937x VDD_BUCK) through the RPM, then topaz-woa
@@ -1422,6 +1457,7 @@ codec_bringup(void)
 	if (!ok) {
 		return false;
 	}
+	if (sapphire_mi2s && !sapphire_mi2s_prepare()) return false;
 	/* 2. LPI pins (SWR clk/data, func1) + slew */
 	for (uint32_t i = 0; i < 6; i++) {
 		lw(LPI_TLMM + 0x1000 * i, pins[i]);
@@ -1782,8 +1818,8 @@ amp_on(bool on)
 	if (sapphire_mode < 0) {
 		int arg = 0;
 		(void)PE_parse_boot_argn("sapphire_amp", &arg, sizeof(arg));
-		sapphire_mode = arg == 1 ? 1 : 0;
-		LOG("amp sapphire_amp=%d", sapphire_mode);
+		sapphire_mode = (arg == 1 || sapphire_mi2s != 0) ? 1 : 0;
+		LOG("amp sapphire_amp=%d sapphire_mi2s=%u effective=%d", arg, sapphire_mi2s, sapphire_mode);
 	}
 	if (sapphire_mode) {
 		sapphire_amp_on(on);
@@ -1820,6 +1856,18 @@ amp_on(bool on)
 
 static uint32_t ring_map, pos_map;
 
+/* FS1815 path bypasses RX_MACRO volume, so attenuate PCM before the DSP reads it.
+ * Each right shift is about 6 dB; the table supplies the remaining 0..5 dB. */
+static uint32_t
+sapphire_gain_for_db(int db)
+{
+	static const uint16_t frac[6] = { 32767, 29204, 26029, 23198, 20675, 18427 };
+	if (db >= 0) return 32767;
+	if (db <= -84) return 0;
+	unsigned loss = (unsigned)-db;
+	return frac[loss % 6] >> (loss / 6);
+}
+
 /* APM_CMD_SHARED_MEM_MAP_REGIONS, raw (no apm_cmd_header); msw 1 = the SMMU SID offset */
 static bool
 mem_map(uint64_t pa, uint32_t bytes, uint32_t prop, uint32_t *handle)
@@ -1844,13 +1892,13 @@ sg_cmd(uint32_t opcode)
 }
 
 /*
- * Graph SH_MEM_PULL_MODE (the DSP reads the ring itself) -> CODEC_DMA_SINK on RX_CODEC_DMA_RX_1
- * (AIF2_PB -> RX2 -> INT2 -> AUX), 48 kHz 16-bit stereo; TopazSpeaker HwStreamPrepare().
+ * Graph SH_MEM_PULL_MODE -> CODEC_DMA_SINK for topaz, or I2S_SINK for
+ * sapphire_mi2s. Both consume 48 kHz 16-bit stereo from the same ring.
  */
 static bool
 graph_open(uint64_t ring_pa, uint32_t ring_bytes, uint64_t pos_pa)
 {
-	static const uint32_t open[] = {
+	uint32_t open[] = {
 		1, 0x08001001, 48, 0, 1, SG, 3, 0x0800100E, 4, 2, 0x0800100F, 4, 1, 0x08001010, 4, 1,
 		1, 0x08001000, 64, 0, 1, CONT, 4, 0x08001011, 8, 1, 3, 0x08001012, 4, 1, 0x08001013, 4, 8192, 0x08001014, 4, 2,
 		1, 0x08001002, 32, 0, 1, SG, CONT, 2, 0x07001006, PULL, 0x07001023, DMA,
@@ -1860,15 +1908,33 @@ graph_open(uint64_t ring_pa, uint32_t ring_bytes, uint64_t pos_pa)
 	const uint32_t ch = 2, rate = 48000;
 	uint32_t mf[12] = { PULL, 0x0800100C, 32, 0, 1, 0x09001000, 20, rate, 16 | (1u << 16), 16 | (15u << 16),
 		            1 | (ch << 16), 1 | (2u << 8) };
+	if (sapphire_mi2s) open[46] = 0x0700100Au; /* MODULE_ID_I2S_SINK */
 	bool ok = mem_map(ring_pa, ring_bytes, 0, &ring_map) && mem_map(pos_pa, 0x1000, 2, &pos_map) &&
 	    apm(APM_GRAPH_OPEN, true, open, sizeof(open) / 4);
 	uint32_t pc[12] = { PULL, 0x0800100A, 28, 0, (uint32_t)ring_pa, 1, ring_bytes, ring_map,
 		            (uint32_t)pos_pa, 1, pos_map, 0 };
 	uint32_t ep[8] = { DMA, 0x08001017, 12, 0, rate, 16 | (ch << 16), 1, 0 };
+	uint32_t factor[6] = { DMA, 0x08001018, 8, 0, 1, 0 };
 	uint32_t intf[8] = { DMA, 0x08001063, 12, 0, 1, 2, 3, 0 };          /* RXTX, RX_1, channels 0x3 */
-
-	ok = ok && apm(APM_SET_CFG, true, mf, 12) && apm(APM_SET_CFG, true, pc, 12) && apm(APM_SET_CFG, true, ep, 8) &&
-	    apm(APM_SET_CFG, true, intf, 8) && sg_cmd(APM_GRAPH_PREPARE);
+	if (sapphire_mi2s) {
+		/* audioreach.h: I2S_SINK=0x0700100a, PARAM_ID_I2S_INTF_CFG=0x08001019;
+		 * lpaif_type=0, intf_idx=0/1, SD0=1, WS internal=1. */
+		intf[1] = 0x08001019;
+		intf[2] = 16; /* 12-byte I2S config padded to 8-byte parameter boundary */
+		intf[4] = 0;
+		intf[5] = sapphire_mi2s - 1;
+		intf[6] = 1 | (1u << 16);
+		ep[2] = 16;
+		LOG("t=%u.%03u MI2S%u endpoint module=%08x intf=%u sd=SD0 ws=internal rate=%u bits=16 ch=%u",
+		    T, sapphire_mi2s, open[46], intf[5], rate, ch);
+	}
+
+	if (ok && !(ok = apm(APM_SET_CFG, true, mf, 12))) LOG("graph media format: FAILED");
+	if (ok && !(ok = apm(APM_SET_CFG, true, pc, 12))) LOG("graph pull config: FAILED");
+	if (ok && !(ok = apm(APM_SET_CFG, true, ep, 8))) LOG("graph hardware format: FAILED");
+	if (ok && !(ok = apm(APM_SET_CFG, true, intf, 8))) LOG("graph endpoint interface: FAILED");
+	if (ok && sapphire_mi2s && !(ok = apm(APM_SET_CFG, true, factor, 6))) LOG("graph I2S frame factor: FAILED");
+	if (ok && !(ok = sg_cmd(APM_GRAPH_PREPARE))) LOG("graph prepare: FAILED");
 	LOG("t=%u.%03u graph open/prepare: %s (maps %x %x)", T, ok ? "OK" : "FAILED", ring_map, pos_map);
 	return ok;
 }
@@ -1892,22 +1958,30 @@ tone_test(unsigned seconds)
 		uint32_t k = f % 48, a = k % 24;
 		int16_t v = a <= 12 ? q[a] : q[24 - a];
 		v = k < 24 ? v : (int16_t)-v;
+		if (sapphire_mi2s) v = (int16_t)(((int32_t)v * (int32_t)sapphire_gain_for_db(vol_db)) >> 15);
 		ring[2 * f] = v;
 		ring[2 * f + 1] = v;
 	}
 	mb();
-	if (!graph_open(ring_pa, bytes, pos_pa) || !sg_cmd(APM_GRAPH_START)) {
-		LOG("tone: graph failed");
+	if (!graph_open(ring_pa, bytes, pos_pa)) {
+		LOG("tone: graph open failed");
 		return;
 	}
-	if (!ports_up) {
+	if (!sg_cmd(APM_GRAPH_START)) {
+		LOG("tone: graph start FAILED (MI2S%u)", sapphire_mi2s);
+		return;
+	}
+	LOG("t=%u.%03u graph start: OK (MI2S%u)", T, sapphire_mi2s);
+	if (!sapphire_mi2s && !ports_up) {
 		ports_and_pa();
 		ports_up = true;
 	}
 	amp_on(true);
-	lw(RX_MACRO + 0x514, (uint32_t)vol_db & 0xFF);
-	lw(RX_MACRO + 0x518, 0x04);
-	lw(RX_MACRO + 0x500, 0x24);                         /* RX2 path on */
+	if (!sapphire_mi2s) {
+		lw(RX_MACRO + 0x514, (uint32_t)vol_db & 0xFF);
+		lw(RX_MACRO + 0x518, 0x04);
+		lw(RX_MACRO + 0x500, 0x24);                         /* RX2 path on */
+	}
 	LOG("t=%u.%03u tone: playing %u s at %d dB", T, seconds, vol_db);
 	for (unsigned t = ms(); ms() - t < seconds * 1000;) {
 		if (!glink_poll()) {
@@ -1916,8 +1990,9 @@ tone_test(unsigned seconds)
 	}
 	LOG("t=%u.%03u tone: DSP position frame %u index %u", T, pos[0], pos[1]);
 	amp_on(false);
-	lw(RX_MACRO + 0x500, 0x04);
-	(void)sg_cmd(APM_GRAPH_STOP);
+	if (!sapphire_mi2s) lw(RX_MACRO + 0x500, 0x04);
+	bool stopped = sg_cmd(APM_GRAPH_STOP);
+	LOG("t=%u.%03u tone graph stop: %s (MI2S%u)", T, stopped ? "OK" : "FAILED", sapphire_mi2s);
 	(void)sg_cmd(APM_GRAPH_CLOSE);
 	LOG("t=%u.%03u tone: stopped", T);
 }
@@ -1944,6 +2019,7 @@ static volatile bool playing;
 static volatile uint32_t write_off;
 static volatile uint64_t last_write;            /* mach_absolute_time() */
 static volatile uint32_t vol_below, vol_muted, vol_gen, vol_applied;
+static volatile uint32_t sapphire_gain_q15;
 static uint64_t frames_in, frames_dropped, underruns;
 static IOLock *stream_lock;
 static bool stream_wake_flag;
@@ -1959,6 +2035,7 @@ stream_open(void)
 		return false;
 	}
 	stream_ready = graph_open(ring_pa, RING_BYTES, pos_pa);
+	if (sapphire_mi2s) sapphire_gain_q15 = sapphire_gain_for_db(vol_db);
 	return stream_ready;
 }
 
@@ -1969,7 +2046,12 @@ apply_volume(void)
 	if (db < -84) {
 		db = -84;
 	}
-	lw(RX_MACRO + 0x514, (uint32_t)db & 0xFF);          /* RX_RX2_RX_VOL_CTL, s8 dB */
+	if (sapphire_mi2s) {
+		sapphire_gain_q15 = sapphire_gain_for_db(db);
+		LOG("t=%u.%03u MI2S%u PCM gain db=%d q15=%u", T, sapphire_mi2s, db, sapphire_gain_q15);
+	} else {
+		lw(RX_MACRO + 0x514, (uint32_t)db & 0xFF);
+	}
 	vol_applied = vol_gen;
 }
 
@@ -1977,21 +2059,27 @@ static void
 stream_start(void)
 {
 	if (stream_ran) {
-		(void)sg_cmd(APM_GRAPH_PREPARE);
+		if (!sg_cmd(APM_GRAPH_PREPARE)) {
+			LOG("stream: graph reprepare FAILED (MI2S%u)", sapphire_mi2s);
+			if (sapphire_mi2s) return;
+		}
 	}
 	if (!sg_cmd(APM_GRAPH_START)) {
-		LOG("stream: start failed");
+		LOG("stream: graph start FAILED (MI2S%u)", sapphire_mi2s);
 		return;
 	}
+	LOG("t=%u.%03u graph start: OK (MI2S%u)", T, sapphire_mi2s);
 	stream_ran = true;
-	if (!ports_up) {
+	if (!sapphire_mi2s && !ports_up) {
 		ports_and_pa();
 		ports_up = true;
 	}
 	amp_on(true);
 	apply_volume();
-	lw(RX_MACRO + 0x518, 0x04);
-	lw(RX_MACRO + 0x500, 0x24);                         /* RX2 path on */
+	if (!sapphire_mi2s) {
+		lw(RX_MACRO + 0x518, 0x04);
+		lw(RX_MACRO + 0x500, 0x24);                         /* RX2 path on */
+	}
 	playing = true;
 	LOG("t=%u.%03u stream: playing", T);
 }
@@ -2000,12 +2088,13 @@ static void
 stream_stop(void)
 {
 	playing = false;
-	lw(RX_MACRO + 0x514, (uint32_t)-84 & 0xFF);         /* mute first, then the amp: no pop */
+	if (!sapphire_mi2s) lw(RX_MACRO + 0x514, (uint32_t)-84 & 0xFF);
 	IOSleep(30);
 	amp_on(false);
 	IOSleep(10);
-	lw(RX_MACRO + 0x500, 0x04);
-	(void)sg_cmd(APM_GRAPH_STOP);
+	if (!sapphire_mi2s) lw(RX_MACRO + 0x500, 0x04);
+	bool stopped = sg_cmd(APM_GRAPH_STOP);
+	LOG("t=%u.%03u graph stop: %s (MI2S%u)", T, stopped ? "OK" : "FAILED", sapphire_mi2s);
 	bzero(ring, RING_BYTES);
 	LOG("t=%u.%03u stream: stopped (%llu frames in, %llu dropped, %llu underruns)", T, frames_in, frames_dropped,
 	    underruns);
@@ -2056,8 +2145,18 @@ topaz_audio_write(const int16_t *frames, uint32_t count)
 		bytes = room;
 	}
 	uint32_t n1 = MIN(bytes, RING_BYTES - w);
-	memcpy(ring + w, frames, n1);
-	memcpy(ring, (const uint8_t *)frames + n1, bytes - n1);
+	if (sapphire_mi2s) {
+		uint32_t gain = sapphire_gain_q15;
+		int16_t *dst = (int16_t *)(ring + w);
+		for (uint32_t i = 0; i < n1 / 2; i++)
+			dst[i] = (int16_t)(((int32_t)frames[i] * (int32_t)gain) >> 15);
+		dst = (int16_t *)ring;
+		for (uint32_t i = 0; i < (bytes - n1) / 2; i++)
+			dst[i] = (int16_t)(((int32_t)frames[n1 / 2 + i] * (int32_t)gain) >> 15);
+	} else {
+		memcpy(ring + w, frames, n1);
+		memcpy(ring, (const uint8_t *)frames + n1, bytes - n1);
+	}
 	/* silence after the data: when iOS stops writing the DSP must not replay the ring (a click at the end) */
 	uint32_t z = (w + bytes) % RING_BYTES, zl = 2 * LEAD_BYTES, z1 = MIN(zl, RING_BYTES - z);
 	bzero(ring + z, z1);
@@ -2255,6 +2354,9 @@ topaz_audio_init(void)
 	if (started || !PE_parse_boot_argn("adsp", &on, sizeof(on)) || on == 0) {
 		return;
 	}
+	(void)PE_parse_boot_argn("sapphire_mi2s", &sapphire_mi2s, sizeof(sapphire_mi2s));
+	if (sapphire_mi2s > 2) sapphire_mi2s = 0;
+	LOG("sapphire_mi2s=%u (0=topaz, 1=primary, 2=secondary)", sapphire_mi2s);
 	started = true;
 	if (kernel_thread_start(topaz_audio_thread, NULL, &thread) == KERN_SUCCESS) {
 		thread_deallocate(thread);
-- 
