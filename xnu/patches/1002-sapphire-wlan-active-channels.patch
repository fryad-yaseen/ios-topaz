From e05372e81028207be338e3e55dc2e78b22523158 Mon Sep 17 00:00:00 2001
From: x <x@x>
Date: Thu, 22 Oct 2026 21:11:16 +0300
Subject: [PATCH] sapphire 1002: Wi-Fi channels outside the 5 GHz radar band
 are not listen-only

topaz_sta.c reported all 37 channels passive. wifid then rejects every join with "no available channel" before ASSOCIATE (seen on sapphire: DISASSOCIATE, set 422 refused, no join). HackiOS's cfg80211 path marks only NO_IR/radar channels.
---
 bsd/dev/topaz_sta.c | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/bsd/dev/topaz_sta.c b/bsd/dev/topaz_sta.c
index f2ffed4..86d320f 100644
--- a/bsd/dev/topaz_sta.c
+++ b/bsd/dev/topaz_sta.c
@@ -144,7 +144,13 @@ sta_channels(struct redwood_sta_channel *channels, unsigned most)
 	unsigned n = 0;
 	for (; n < most && n < sizeof(sta_freqs) / sizeof(sta_freqs[0]); n++) {
 		channels[n].frequency = sta_freqs[n];
-		channels[n].flags = REDWOOD_STA_CHANNEL_PASSIVE;
+		/*
+		 * Only the 5 GHz radar channels (52-144) are listen-only, as cfg80211 reports them
+		 * on HackiOS. With every channel passive, wifid finds no channel it may join on
+		 * ("no available channel") and never sends ASSOCIATE.
+		 */
+		channels[n].flags = sta_freqs[n] >= 5260 && sta_freqs[n] <= 5720 ?
+		    REDWOOD_STA_CHANNEL_PASSIVE | REDWOOD_STA_CHANNEL_RADAR : 0;
 	}
 	return n;
 }
