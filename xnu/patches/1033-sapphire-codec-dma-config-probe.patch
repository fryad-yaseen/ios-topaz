From b23421731a88b3c4b4b08bcf43b4a4f5df6775b9 Mon Sep 17 00:00:00 2001
From: Sapphire local <noreply@local.invalid>
Date: Sat, 24 Oct 2026 16:06:55 +0300
Subject: [PATCH] sapphire: probe codec DMA frame factor and power mode

---
 iokit/Kernel/arm/TopazAudio.cpp | 16 +++++++++++++++-
 1 file changed, 15 insertions(+), 1 deletion(-)

diff --git a/iokit/Kernel/arm/TopazAudio.cpp b/iokit/Kernel/arm/TopazAudio.cpp
index 5145d85..a15e406 100644
--- a/iokit/Kernel/arm/TopazAudio.cpp
+++ b/iokit/Kernel/arm/TopazAudio.cpp
@@ -2847,6 +2847,9 @@ as_run(unsigned section, bool periodic = false, unsigned elapsed = 0)
 static bool
 graph_open(uint64_t ring_pa, uint32_t ring_bytes, uint64_t pos_pa)
 {
+	uint32_t dma_cfg = 0;
+	(void)PE_parse_boot_argn("sapphire_dma_cfg", &dma_cfg, sizeof(dma_cfg));
+	if (dma_cfg > 3) dma_cfg = 0;
 	static const uint32_t open[] = {
 		1, 0x08001001, 48, 0, 1, SG, 3, 0x0800100E, 4, 2, 0x0800100F, 4, 1, 0x08001010, 4, 1,
 		1, 0x08001000, 64, 0, 1, CONT, 4, 0x08001011, 8, 1, 3, 0x08001012, 4, 1, 0x08001013, 4, 8192, 0x08001014, 4, 2,
@@ -2868,11 +2871,22 @@ graph_open(uint64_t ring_pa, uint32_t ring_bytes, uint64_t pos_pa)
 		            (uint32_t)pos_pa, 1, pos_map, 0 };
 	uint32_t ep[8] = { DMA, 0x08001017, 12, 0, rate, as_graph_bits | (ch << 16), 1, 0 };
 	uint32_t intf[8] = { DMA, 0x08001063, 12, 0, as_graph_intf, as_graph_port, as_graph_dma_index, 0 };          /* RXTX, RX_1, channels 0x3 */
+	/* Linux AudioReach also sends these codec-DMA endpoint parameters.
+	 * Test each independently; mode 3 sends both. Mode 0 keeps the old graph. */
+	uint32_t frame[5] = { DMA, 0x08001018, 4, 0, 1 };
+	uint32_t power[5] = { DMA, 0x08001176, 4, 0, 0 };
 
 	as_override_payload(mf, 12); as_override_payload(pc, 12);
 	as_override_payload(ep, 8); as_override_payload(intf, 8);
 	ok = ok && apm(APM_SET_CFG, true, mf, 12) && apm(APM_SET_CFG, true, pc, 12) && apm(APM_SET_CFG, true, ep, 8) &&
-	    apm(APM_SET_CFG, true, intf, 8) && sg_cmd(APM_GRAPH_PREPARE);
+	    apm(APM_SET_CFG, true, intf, 8);
+	bool frame_ok = true, power_ok = true;
+	if (ok && (dma_cfg & 1)) frame_ok = apm(APM_SET_CFG, true, frame, 5);
+	if (ok && frame_ok && (dma_cfg & 2)) power_ok = apm(APM_SET_CFG, true, power, 5);
+	if (dma_cfg) LOG("dma cfg mode=%u frame=%s power=%s", dma_cfg,
+	    !(dma_cfg & 1) ? "SKIP" : frame_ok ? "OK" : "FAILED",
+	    !(dma_cfg & 2) ? "SKIP" : power_ok ? "OK" : "FAILED");
+	ok = ok && frame_ok && power_ok && sg_cmd(APM_GRAPH_PREPARE);
 	LOG("t=%u.%03u graph open/prepare: %s (maps %x %x)", T, ok ? "OK" : "FAILED", ring_map, pos_map);
 	return ok;
 }
