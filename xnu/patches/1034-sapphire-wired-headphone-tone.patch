+/* Android headphones: RXTX RX_0, AIF1 RX0/RX1 -> INT0/1 -> DP1 L/R.
+ * Sources: mixer_paths_bengal_idp.xml headphones + global CLS_AB/COMP=0;
+ * Linux lpass-rx-macro.c, wcd937x.c, wcd937x-sdw.c and wcd-clsh-v2.c.
+ * Captured Android SWR timing is reused, NOT claimed as an HPH capture.
+ * CLS_AB still uses the WCD937x v3 flyback/buck state machine. */
+static bool sapphire_hph_up;
+
+static bool
+sapphire_hph_ports(bool on)
+{
+	swr_wr(RX_SWR, 1, 0x041, 4);
+	swr_wr(RX_SWR, 1, 0x045, 8);
+	unsigned next = (lr(RX_SWR + 0x104c) & 1u) ^ 1u;
+	lw(RX_SWR + 0x112c, 1); /* 16-bit block length; captured speaker timing */
+	for (unsigned bank = 0; bank < 2; bank++) {
+		unsigned b = bank ? next ^ 1u : next;
+		/* DP1 carries HPH_L/R bits 0/1, lane 1, sample interval 3.
+		 * Disable all other ports, including inherited AUX/CLSH/COMP. */
+		for (unsigned port = 1; port <= 4; port++) {
+			uint32_t base = 0x1000 + port * 0x100 + b * 0x40;
+			lw(RX_SWR + base + 0x24, on && port == 1 ? 0x03000003u : 0);
+			lw(RX_SWR + base + 0x28, port == 1 ? 1 : 0);
+			for (unsigned r = 0x30; r <= 0x3c; r += 4) lw(RX_SWR + base + r, 0);
+			for (unsigned r = 0x20; r <= 0x28; r++) {
+				uint8_t v = 0;
+				if (port == 1) {
+					if (r == 0x20) v = on ? 3 : 0;
+					if (r == 0x22) v = 3;
+					if (r == 0x28) v = 1;
+				}
+				swr_wr(RX_SWR, 1, port * 0x100 + b * 0x10 + r, v);
+			}
+			swr_wr(RX_SWR, 1, port * 0x100 + 3, port == 1 ? 1 : 0);
+		}
+		lw(RX_SWR + 0x101c + b * 0x40, b ? 0x5000f : 0x2f0008);
+		if (bank == 0 && !sapphire_swr_android_switch(b)) return false;
+	}
+	return true;
+}
+
+static void
+sapphire_hph_off(void)
+{
+	if (!sapphire_hph_up) return;
+	for (unsigned n = 0; n < 2; n++)
+		sapphire_rx_bits(0x400 + n * 0x80, 0x10, 0x10, "HPH mute");
+	IOSleep(20);
+	/* DAPM PGA bits off, POST_PMD delay, watchdog off, then PA bias. */
+	sapphire_wcd_bits(0x3009, 0xc0, 0, "HPH PGA off");
+	IOSleep(20);
+	sapphire_wcd_bits(0x3465, 7, 0, "HPHL WD off");
+	sapphire_wcd_bits(0x3466, 7, 0, "HPHR WD off");
+	sapphire_wcd_bits(0x3009, 0x30, 0, "HPH PA bias off");
+	/* Last v3 class-H user: normal mode, flyback off, buck off. */
+	sapphire_wcd_bits(0x3009, 0x0c, 0, "HPH normal mode");
+	sapphire_wcd_bits(0x3008, 0x40, 0, "HPH flyback off");
+	IODelay(100);
+	sapphire_wcd_bits(0x30af, 0xe0, 0xe0, "HPH VNEG DAC");
+	IODelay(500);
+	sapphire_wcd_bits(0x3008, 0x80, 0, "HPH buck off");
+	IODelay(500);
+	sapphire_wcd_bits(0x3098, 0xff, 0x3a, "HPH buck settle");
+	IODelay(500);
+	sapphire_wcd_bits(0x3138, 0x20, 0, "HPH IQ reset");
+	sapphire_wcd_bits(0x30bf, 0xf0, 0x80, "HPH bias reset");
+	sapphire_wcd_bits(0x30d1, 0x0e, 6, "HPH PA reset");
+	sapphire_wcd_bits(0x30a8, 0xf0, 0x70, "HPH flyback default");
+	sapphire_wcd_bits(0x3008, 0x0c, 0, "HPH supply default");
+	for (unsigned n = 0; n < 2; n++) {
+		sapphire_wcd_bits(0x3133 + n * 3, 0x0f, 1, "HPH RDAC HD2 off");
+		sapphire_rx_bits(0x400 + n * 0x80, 0x30, 0x10, "HPH RX clock off");
+		sapphire_rx_bits(0x440 + n * 0x80, 1, 0, "HPH DSM off");
+		sapphire_rx_bits(0x404 + n * 0x80, 0x40, 0, "HPH CLSH off");
+	}
+	sapphire_wcd_bits(0x30d2, 0x50, 0x50, "HPH pull down");
+	sapphire_wcd_bits(0x3409, 3, 0, "HPH DAC clocks off");
+	sapphire_wcd_bits(0x3008, 1, 0, "HPH RX bias off");
+	sapphire_wcd_bits(0x3408, 3, 0, "HPH RX clocks off");
+	if (!sapphire_hph_ports(false)) LOG("HPH transport stop failed");
+	sapphire_rx_bits(0x200, 1, 0, "HPH CLSH clock off");
+	sapphire_hph_up = false;
+	LOG("HPH stopped");
+}
+
+static bool
+sapphire_hph_on(void)
+{
+	bool ok = true;
+	sapphire_hph_up = true; /* partial failures must unwind */
+	/* AIF muxes are software bookkeeping. INP0 enum RX0=5, RX1=6. */
+	sapphire_rx_bits(0x180, 0xff, 5, "HPH INT0 INP0 RX0");
+	sapphire_rx_bits(0x188, 0xff, 6, "HPH INT1 INP0 RX1");
+	sapphire_rx_bits(0x190, 0xff, 0, "HPH AUX disconnect");
+	sapphire_rx_bits(0x200, 1, 1, "HPH class-H clock");
+	sapphire_rx_bits(0x204, 7, 0, "HPH class-H decay");
+	sapphire_rx_bits(0x20c, 0x3f, 0x1c, "HPH class-H voltage");
+	sapphire_rx_bits(0x21c, 0x0f, 0, "HPH K1 MSB");
+	sapphire_rx_bits(0x220, 0xff, 0xc0, "HPH K1 LSB");
+	for (unsigned n = 0; n < 2; n++) {
+		uint32_t o = n * 0x80;
+		sapphire_rx_bits(0x400 + o, 0x7f, 0x34, "HPH RX 48k muted");
+		sapphire_rx_bits(0x404 + o, 0x48, 0x48, "HPH CLSH lookahead");
+		sapphire_rx_bits(0x408 + o, 3, 1, "HPH DEM, not EAR");
+		sapphire_rx_bits(0x40c + o, 3, 3, "HPH HPF");
+		sapphire_rx_bits(0x414 + o, 0xff, (uint8_t)-18, "HPH -18dB");
+		sapphire_rx_bits(0x418 + o, 0x30, 0, "HPH mix unmute");
+		sapphire_rx_bits(0x440 + o, 1, 1, "HPH DSM clock");
+	}
+	if (!sapphire_hph_ports(true)) { sapphire_hph_off(); return false; }
+	/* wcd937x_rx_clk_enable, then RDAC PRE_PMU. */
+	ok &= sapphire_wcd_bits(0x3409, 8, 8, "HPH digital MCLK");
+	ok &= sapphire_wcd_bits(0x3408, 1, 1, "HPH analog MCLK");
+	ok &= sapphire_wcd_bits(0x3008, 1, 1, "HPH RX bias");
+	for (unsigned n = 0; n < 3; n++)
+		ok &= sapphire_wcd_bits(0x340d + n, 0x40, 0, "HPH RX reset release");
+	ok &= sapphire_wcd_bits(0x3408, 2, 2, "HPH RX clock");
+	ok &= sapphire_wcd_bits(0x3409, 3, 3, "HPH L/R DAC clocks");
+	ok &= sapphire_wcd_bits(0x344e, 0x0c, 0x0c, "HPH gain source");
+	ok &= sapphire_wcd_bits(0x30d9, 0x80, 0, "HPH RDAC clock");
+	ok &= sapphire_wcd_bits(0x3414, 3, 0, "HPH companders off");
+	/* ALSA volume is inverted. Avoid code 20, the minimum/mute end;
+	 * use attenuated code 12 rather than XML value 20 (register zero). */
+	ok &= sapphire_wcd_bits(0x30d3, 0x3f, 0x2c, "HPHL low gain no comp");
+	ok &= sapphire_wcd_bits(0x30d6, 0x3f, 0x2c, "HPHR low gain no comp");
+	ok &= sapphire_wcd_bits(0x313a, 2, 0, "HPH timer PRE_PMU");
+	/* wcd_clsh_v3_state_hph_l/r(CLS_AB), shared supplies once. */
+	ok &= sapphire_wcd_bits(0x3008, 6, 0, "HPH v3 regulator/default");
+	ok &= sapphire_wcd_bits(0x30a8, 0xf0, 0x70, "HPH flyback mode");
+	ok &= sapphire_wcd_bits(0x30af, 0xe0, 0xa0, "HPH force IQ");
+	IODelay(100);
+	ok &= sapphire_wcd_bits(0x3099, 2, 2, "HPH class-H mode3");
+	ok &= sapphire_wcd_bits(0x3098, 0xff, 0x1c, "HPH class-H mode2");
+	ok &= sapphire_wcd_bits(0x30a5, 0xe0, 0xe0, "HPH flyback control");
+	ok &= sapphire_wcd_bits(0x3008, 0x40, 0x40, "HPH flyback enable");
+	IODelay(100);
+	ok &= sapphire_wcd_bits(0x30af, 0xe0, 0xe0, "HPH VNEG DAC");
+	IODelay(500);
+	ok &= sapphire_wcd_bits(0x30c7, 0xff, 0xaa, "HPH flyback current");
+	IODelay(100);
+	ok &= sapphire_wcd_bits(0x3008, 8, 0, "HPH buck default");
+	ok &= sapphire_wcd_bits(0x3008, 0x80, 0x80, "HPH buck enable");
+	IODelay(500);
+	ok &= sapphire_wcd_bits(0x3098, 0xff, 0x3a, "HPH buck settle");
+	IODelay(500);
+	ok &= sapphire_wcd_bits(0x3009, 0x0c, 0x0c, "HPH CLS_AB");
+	ok &= sapphire_wcd_bits(0x3009, 0x30, 0x30, "HPH PA PRE_PMU");
+	IODelay(100);
+	ok &= sapphire_wcd_bits(0x3465, 7, 3, "HPHL watchdog");
+	ok &= sapphire_wcd_bits(0x3466, 7, 3, "HPHR watchdog");
+	if (!ok) { sapphire_hph_off(); return false; }
+	/* DAPM PGA register write between PRE_PMU and POST_PMU. */
+	ok &= sapphire_wcd_bits(0x30d2, 0x50, 0, "HPH release pull down");
+	ok &= sapphire_wcd_bits(0x3009, 0xc0, 0xc0, "HPHL/R PGA enable");
+	IOSleep(20); /* no companders: Linux requires 20000..20100 us */
+	ok &= sapphire_wcd_bits(0x313a, 2, 2, "HPH timer POST_PMU");
+	ok &= sapphire_wcd_bits(0x3008, 2, 2, "HPH CLS_AB post PA");
+	if (!ok) { sapphire_hph_off(); return false; }
+	for (unsigned n = 0; n < 2; n++)
+		sapphire_rx_bits(0x400 + n * 0x80, 0x10, 0, "HPH unmute");
+	LOG("HPH ready RX_0 AIF1 DP1 stereo CLS_AB -18dB, analog gain code 12");
+	return true;
+}
+
