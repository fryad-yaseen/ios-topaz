 		ports_and_pa();
 		ports_up = true;
 	}
-	if (sapphire_route_failed) {
+	if (!sapphire_hph_enabled() && sapphire_route_failed) {
 		(void)sg_cmd(APM_GRAPH_STOP);
 		(void)sg_cmd(APM_GRAPH_CLOSE);
 		LOG("tone: sapphire SoundWire setup failed");
 		return;
 	}
-	if (sapphire_spk_enabled()) {
+	if (sapphire_hph_enabled()) {
+		/* Headphone route already powered before graph START. */
+	} else if (sapphire_spk_enabled()) {
 		sapphire_rx_bits(0x414, 0xff, sapphire_spk_ref_enabled() ? 0u : (uint32_t)vol_db & 0xff, "tone EAR volume");
 		sapphire_rx_bits(0x514, 0xff, sapphire_spk_ref_enabled() ? 0xfcu : (uint32_t)vol_db & 0xff, "tone AUX volume");
 		if (!sapphire_spk_dma_enabled() && !sapphire_codec_on()) {
@@ -3109,7 +3292,9 @@ tone_test(unsigned seconds, unsigned test_mode)
 		lw(RX_MACRO + 0x518, 0x04);
