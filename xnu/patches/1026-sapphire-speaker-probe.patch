From fa38978cde7b85c3658f9be1c8577795b8177898 Mon Sep 17 00:00:00 2001
From: fryad-yaseen <fryadyazeez@gmail.com>
Date: Sat, 24 Oct 2026 10:23:50 +0300
Subject: [PATCH] sapphire: sample speaker route state during ADSP tone

---
 iokit/Kernel/arm/TopazAudio.cpp | 48 ++++++++++++++++++++++++++++++++-
 1 file changed, 47 insertions(+), 1 deletion(-)

diff --git a/iokit/Kernel/arm/TopazAudio.cpp b/iokit/Kernel/arm/TopazAudio.cpp
index eda1df3..5adee19 100644
--- a/iokit/Kernel/arm/TopazAudio.cpp
+++ b/iokit/Kernel/arm/TopazAudio.cpp
@@ -2654,6 +2654,45 @@ graph_open(uint64_t ring_pa, uint32_t ring_bytes, uint64_t pos_pa)
 	return ok;
 }
 
+/* Read-only observation. No LPASS codec-DMA pointer is exposed in this mapped
+ * RX macro/SWR register window: the DMA sink and its position live on ADSP.
+ * The only advancing byte position available to APPS is the pull-mode SHMEM
+ * position below. RX and SWR registers here are route/error state, not PCM
+ * level meters or frame counters; a constant value does not prove silence.
+ * swr_rd issues a read command into the SWR FIFO, the only probe write.
+ * FS1815 registers 03/04 are status (fs1815.c); it defines no input meter.
+ */
+static bool
+sapphire_spk_probe_enabled(void)
+{
+	static int enabled = -1;
+	if (enabled < 0) {
+		int arg = 0;
+		enabled = PE_parse_boot_argn("sapphire_spk_probe", &arg, sizeof(arg)) && arg == 1;
+	}
+	return enabled != 0;
+}
+
+static void
+sapphire_spk_probe_sample(unsigned n, volatile uint32_t *pos)
+{
+	uint8_t ear = 0, aux = 0;
+	bool ear_ok = swr_rd(VA_SWR, 1, 0x30ef, &ear);
+	bool aux_ok = swr_rd(VA_SWR, 1, 0x31c3, &aux);
+	uint16_t fs[4] = { 0xffff, 0xffff, 0xffff, 0xffff };
+	int e0 = sapphire_fs_read(0x34, 0x03, &fs[0]);
+	int e1 = sapphire_fs_read(0x34, 0x04, &fs[1]);
+	int e2 = sapphire_fs_read(0x35, 0x03, &fs[2]);
+	int e3 = sapphire_fs_read(0x35, 0x04, &fs[3]);
+	LOG("spkprobe %02u t=%u pos=%u/%u rx180=%02x rx190=%02x rx400=%02x rx500=%02x swr1=%08x swr4=%08x fifo=%08x irq=%08x wcd=%02x/%02x ok=%d%d fs34=%04x/%04x fs35=%04x/%04x err=%d,%d,%d,%d",
+	    n, ms(), pos[0], pos[1], lr(RX_MACRO + 0x180) & 0xff,
+	    lr(RX_MACRO + 0x190) & 0xff, lr(RX_MACRO + 0x400) & 0xff,
+	    lr(RX_MACRO + 0x500) & 0xff, lr(RX_SWR + 0x1124),
+	    lr(RX_SWR + 0x1424), lr(RX_SWR + 0x30c), lr(RX_SWR + 0x200),
+	    ear, aux, ear_ok, aux_ok, fs[0], fs[1], fs[2], fs[3],
+	    e0, e1, e2, e3);
+}
+
 /* boot-arg adsp_tone=N: N seconds of 1 kHz from the speaker, once the codec is up */
 static void
 tone_test(unsigned seconds)
@@ -2731,7 +2770,14 @@ tone_test(unsigned seconds)
 		LOG("t=%u.%03u tone: playing %u s, EAR 0 dB AUX -4 dB", T, seconds);
 	else
 		LOG("t=%u.%03u tone: playing %u s at %d dB", T, seconds, vol_db);
-	for (unsigned t = ms(); ms() - t < seconds * 1000;) {
+	unsigned probe_start = ms(), probe_next = probe_start, probe_n = 0;
+	bool probe = sapphire_spk_probe_enabled();
+	for (unsigned t = probe_start; ms() - t < seconds * 1000;) {
+		if (probe && probe_n < seconds * 20 && ms() >= probe_next) {
+			sapphire_spk_probe_sample(probe_n++, pos);
+			probe_next += 50;
+			if (probe_next < ms()) probe_next = ms() + 50;
+		}
 		if (!glink_poll()) {
 			IOSleep(2);
 		}
-- 
