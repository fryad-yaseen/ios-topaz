@@ -1431,6 +1431,20 @@ sapphire_spk_ref_enabled(void)
 	return enabled != 0;
 }
 
+/* Reproduce the RX SoundWire transport captured on sapphire Android. */
+static bool
+sapphire_swr_ref_enabled(void)
+{
+	static int enabled = -1;
+	if (enabled < 0) {
+		int arg = 0;
+		(void)PE_parse_boot_argn("sapphire_swr_ref", &arg, sizeof(arg));
+		enabled = arg == 1;
+		LOG("sapphire_swr_ref=%d", enabled);
+	}
+	return enabled != 0;
+}
