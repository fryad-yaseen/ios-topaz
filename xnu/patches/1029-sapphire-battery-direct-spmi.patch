@@ -164,7 +165,8 @@ SweetBattery::publish(unsigned percent, unsigned mv, int ma, bool external,
 	int mode = measured ? 1 : 0;
 	if (mode != fLastMode) {
 		IOLog("SWEET BATTERY: %s, %u%% %umV external=%d charging=%d\n",
-		    measured ? (fSapphire ? "ADSP battery manager" : "PM6150 / estimated SOC") : "static fallback",
+		    measured ? (fSapphireDirect ? "PM7250B direct / estimated SOC" :
