+/* PM7250B on SPMI SID 2, as identified by the live DT and Android QG log.
+ * QG 0x48c0 is the last ADC voltage (194.637 uV/LSB). The monotonic SOC
+ * register 0x48bf is written by Linux's qg-soc algorithm, so it is stale
+ * after the OS handoff and must not be presented as a live hardware SOC.
+ * No QG hold bit, page selector, or charger register is written here.
+ * Qualcomm sources: drivers/power/supply/qcom/{qg-reg.h,qg-defs.h,
+ * qg-util.c,qg-soc.c} in android.googlesource.com/kernel/msm.
+ */
+bool
+SweetBattery::pollSapphireDirect(void)
+{
+	uint8_t type, subtype, present, vlo, vhi, usb, path, chg, err, temp;
+	if (sweet_spmi_read(2, 0x4804, &type) || type != 0x0d ||
+	    sweet_spmi_read(2, 0x4805, &subtype) || subtype != 4 ||
+	    sweet_spmi_read(2, 0x4808, &present) || !(present & 1u) ||
+	    sweet_spmi_read(2, 0x48c0, &vlo) ||
+	    sweet_spmi_read(2, 0x48c1, &vhi) ||
+	    sweet_spmi_read(2, 0x1310, &usb) ||
+	    sweet_spmi_read(2, 0x110b, &path) ||
+	    sweet_spmi_read(2, 0x1006, &chg) ||
+	    sweet_spmi_read(2, 0x1007, &err) ||
+	    sweet_spmi_read(2, 0x100d, &temp))
+		return false;
+	unsigned raw = (unsigned)vlo | ((unsigned)vhi << 8);
+	unsigned mv = (unsigned)(((uint64_t)raw * 194637u) / 1000000u);
+	if (raw == 0x8000 || mv < 2800 || mv > 4600)
+		return false;
+	bool external = (usb & 0x10u) != 0;
+	bool capable = external && (path & 0x10u) && (path & 1u) && !(path & 0x40u);
+	unsigned state = chg & 7u;
+	bool charging = capable && state >= 1 && state <= 4 &&
+	    !(err & 2u) && !(temp & 0x0cu);
+	bool full = external && state == 5 && !(err & 2u);
+	publish(full ? 100 : estimatePercent(mv), mv, 0, external, capable,
+	    charging, full, true, false, 2500, 5000, 0, true, true);
+	return true;
+}
+
 void
 SweetBattery::poll(void)
 {
+	if (fSapphireDirect) {
+		if (!pollSapphireDirect())
+			publish(100, 4200, 0, false, false, false, false, false, false);
+		return;
+	}
 	if (fSapphire) {
 		struct sapphire_batt_sample s;
 		if (sapphire_battmgr_sample(&s)) {
@@ -444,7 +489,7 @@ SweetBattery::timerFired(OSObject *owner, IOTimerEventSource *sender)
 	SweetBattery *self = OSDynamicCast(SweetBattery, owner);
 	if (self && self->fRunning) {
 		self->poll();
-		sender->setTimeoutMS(10000);
+		sender->setTimeoutMS(self->fSapphireDirect ? 20000 : 10000);
 	}
 }
 
@@ -459,8 +504,11 @@ SweetBattery::start(IOService *provider)
 	(void)PE_parse_boot_argn("sweetbattery", &real, sizeof(real));
 	int sapphire = 0;
 	(void)PE_parse_boot_argn("sapphire_batt", &sapphire, sizeof(sapphire));
-	fSapphire = sapphire == 1;
-	fReal = fSapphire || (real == 1 && sweet_i2c1_init() == 0);
+	int direct = 0;
+	(void)PE_parse_boot_argn("sapphire_batt_direct", &direct, sizeof(direct));
+	fSapphireDirect = direct == 1 && sweet_spmi_init() == 0;
+	fSapphire = !fSapphireDirect && sapphire == 1;
+	fReal = fSapphireDirect || fSapphire || (real == 1 && sweet_i2c1_init() == 0);
 	/* Publish a complete source BEFORE registerService wakes powerd. */
 	poll();
 	if (fReal) {
@@ -469,7 +517,7 @@ SweetBattery::start(IOService *provider)
 		if (fLoop && fTimer && fLoop->addEventSource(fTimer) == kIOReturnSuccess) {
 			fTimerAdded = true;
 			fRunning = true;
-			fTimer->setTimeoutMS(10000);
+			fTimer->setTimeoutMS(fSapphireDirect ? 20000 : 10000);
 		} else {
 			fReal = false;
 			poll();
