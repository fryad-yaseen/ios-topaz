+/* Downstream msm-poweroff writes 0x77665502 to the device's IMEM
+ * restart_reason@65c for recovery. The shim maps this same word for its
+ * bootloader reset. See Linux drivers/power/reset/msm-poweroff.c:
+ * https://android.googlesource.com/kernel/msm/+/81b58f308fad0a0020eed4dfdec4bdaf51593c6b/drivers/power/reset/msm-poweroff.c
+ * and Linux drivers/power/reset/qcom-pon.c (PON_SOFT_RB_SPARE 0x8f).
+ * PSCI SYSTEM_RESET (SMC32 0x84000009) performs the reset.
+ * Only this one IMEM word is touched. */
+#define SAPPHIRE_RESTART_REASON_PA 0x0c12565cULL
+#define SAPPHIRE_RECOVERY_REASON  0x77665502U
+static void
+sapphire_autoreboot_thread(void *arg, wait_result_t wr __unused)
+{
+	uint32_t secs = (uint32_t)(uintptr_t)arg;
+	uint64_t uptime_ns = 0;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &uptime_ns);
+	uint32_t elapsed = (uint32_t)(uptime_ns / 1000000000ULL);
+	if (elapsed < secs)
+		(void)tsleep(&sweet_log_chan, PZERO, "asreboot", hz * (int)(secs - elapsed));
+	printf("SWEET LOG: autoreboot recovery after %u s\n", secs);
+	if (!sweet_log_flush()) printf("SWEET LOG: final flush failed\n");
+	volatile uint32_t *reason = (volatile uint32_t *)ml_io_map(SAPPHIRE_RESTART_REASON_PA, 4);
+	if (reason) {
+		*reason = SAPPHIRE_RECOVERY_REASON;
+		__asm__ volatile ("dsb sy" ::: "memory");
 	}
+	register uint64_t x0 __asm__("x0") = 0x84000009;
+	__asm__ volatile ("smc #0" : "+r"(x0) :: "memory");
+	for (;;) { }
 }
 
 static void
 sweet_log_start(void)
 {
-	uint32_t on = 1;
+	uint32_t on = 1, reboot_secs = 0;
 	thread_t thread;
+	(void)PE_parse_boot_argn("sapphire_autoreboot", &reboot_secs, sizeof(reboot_secs));
+	if (reboot_secs > 300) reboot_secs = 0;
 
 	PE_parse_boot_argn("sweetlog", &on, sizeof(on));
+	if (reboot_secs) on = 1;
 	if (!on || !su.writable || su.nblocks < 2 * SWEET_LOG_BLOCKS) {
 		return;
 	}
@@ -971,6 +1016,10 @@ sweet_log_start(void)
 	if (kernel_thread_start(sweet_log_thread, NULL, &thread) == KERN_SUCCESS) {
 		thread_deallocate(thread);
 	}
+	if (reboot_secs && kernel_thread_start(sapphire_autoreboot_thread,
+	    (void *)(uintptr_t)reboot_secs, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
 }
 
