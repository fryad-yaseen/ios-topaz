 	return apm(opcode, true, dw, 6);
 }
 
+/* ADT experiment script. The ADT size field permits 2^31-1 bytes, but keep
+ * a private 8 KiB copy so a malformed property cannot consume kernel memory.
+ * Lines are immutable after parsing; only the audio worker executes them. */
+#define AS_MAX 8192
+#define AS_LINES 128
+struct as_line { char *text; uint8_t section; uint16_t every; };
+static char as_text[AS_MAX];
+static as_line as_lines[AS_LINES];
+static unsigned as_count;
+static unsigned as_due[AS_LINES];
+static bool as_enabled;
+static uint32_t as_tone_hz = 1000, as_tone_secs, as_tone_amp = 3277, as_tone_side = 3;
+static uint32_t as_graph_rate = 48000, as_graph_bits = 16, as_graph_channels = 2;
+static uint32_t as_graph_chmap = 0x201, as_graph_intf = 1, as_graph_port = 2, as_graph_dma_index = 3;
+struct as_override { uint32_t module, param, offset, value; };
+static as_override as_overrides[32];
+static unsigned as_override_count;
+static bool as_graph_prepared;
+
+static bool
+as_num(const char *s, uint32_t *out)
+{
+	if (!s || !*s) return false;
+	unsigned base = (s[0] == '0' && (s[1] == 'x' || s[1] == 'X')) ? 16 : 10;
+	if (base == 16) s += 2;
+	uint64_t n = 0;
+	if (!*s) return false;
+	for (; *s; s++) {
+		unsigned d = *s >= '0' && *s <= '9' ? *s - '0' :
+		    *s >= 'a' && *s <= 'f' ? *s - 'a' + 10 :
+		    *s >= 'A' && *s <= 'F' ? *s - 'A' + 10 : 99;
+		if (d >= base) return false;
+		n = n * base + d;
+		if (n > 0xffffffffu) return false;
+	}
+	*out = (uint32_t)n;
+	return true;
+}
+
+static void
+as_load(void)
+{
+	int arg = 0;
+	DTEntry chosen;
+	const void *prop;
+	unsigned int len;
+	if (!PE_parse_boot_argn("sapphire_ascript", &arg, sizeof(arg)) || arg != 1) return;
+	if (SecureDTLookupEntry(NULL, "/chosen", &chosen) != kSuccess ||
+	    SecureDTGetProperty(chosen, "sapphire-audio-script", &prop, &len) != kSuccess ||
+	    len < 2 || len > AS_MAX || ((const char *)prop)[len - 1] != '\0' ||
+	    memchr(prop, '\0', len - 1) != NULL) {
+		LOG("as load -> missing or oversized ADT property");
+		return;
+	}
+	memcpy(as_text, prop, len);
+	as_enabled = true;
+	unsigned section = 0;
+	for (char *p = as_text; *p && as_count < AS_LINES;) {
+		char *line = p;
+		while (*p && *p != '\n') p++;
+		if (*p) *p++ = '\0';
+		while (*line == ' ' || *line == '\t') line++;
+		char *end = line + strlen(line);
+		while (end > line && (end[-1] == ' ' || end[-1] == '\t' || end[-1] == '\r')) *--end = '\0';
+		if (!*line || *line == '#') continue;
+		if (strlen(line) >= 160) { LOG("as parse -> line too long"); continue; }
+		if (!strcmp(line, "@codec")) section = 1;
+		else if (!strcmp(line, "@graph")) section = 2;
+		else if (!strcmp(line, "@tone")) section = 3;
+		else if (!strcmp(line, "@stop")) section = 4;
+		else if (section) {
+			uint16_t every = 0;
+			if (!strncmp(line, "every ", 6)) {
+				char *q = line + 6, *space = strchr(q, ' ');
+				uint32_t n = 0;
+				if (!space) { LOG("as parse %s -> bad interval", line); continue; }
+				*space++ = '\0';
+				unsigned z = strlen(q);
+				if (z >= 3 && !strcmp(q + z - 2, "ms")) q[z - 2] = '\0';
+				if (!as_num(q, &n) || n < 10 || n > 10000 || section != 3) {
+					LOG("as parse every -> bad interval"); continue;
+				}
+				every = (uint16_t)n; line = space;
+			}
+			as_lines[as_count++] = { line, (uint8_t)section, every };
+		} else LOG("as parse %s -> no section", line);
+	}
+	LOG("as load -> %u lines%s", as_count, as_count == AS_LINES ? " (limit)" : "");
+}
+
+static bool
+as_mmio(uint32_t pa)
+{
+	if (pa & 3) return false;
+	if (pa >= LPASS_PA && pa <= LPASS_PA + LPASS_SIZE - 4 && lpass) return true;
+	if (pa >= TLMM_GPIO92_PA && pa <= TLMM_GPIO92_PA + 0xffc && gpio92) return true;
+	if (pa >= SAPPHIRE_GPIO99_PA && pa <= SAPPHIRE_GPIO99_PA + 0xffc && sapphire_gpio[1]) return true;
+	if (pa >= SAPPHIRE_GPIO105_PA && pa <= SAPPHIRE_GPIO105_PA + 0xffc && sapphire_gpio[0]) return true;
+	return false;
+}
+static volatile uint32_t *
+as_mmio_ptr(uint32_t pa)
+{
+	if (!as_mmio(pa)) return NULL;
+	if (pa >= LPASS_PA) return (volatile uint32_t *)(lpass + pa - LPASS_PA);
+	if (pa >= SAPPHIRE_GPIO105_PA) return (volatile uint32_t *)(sapphire_gpio[0] + pa - SAPPHIRE_GPIO105_PA);
+	if (pa >= SAPPHIRE_GPIO99_PA) return (volatile uint32_t *)(sapphire_gpio[1] + pa - SAPPHIRE_GPIO99_PA);
+	return (volatile uint32_t *)(gpio92 + pa - TLMM_GPIO92_PA);
+}
+
+/* APM_SET_CFG payloads use [module, param, bytes, reserved] then parameter
+ * words. mf[12] media format: word 7 rate, 8 bit depth/Q, 10 channels,
+ * 11 channel map. pc[12] pull memory; ep[8] endpoint: 4 rate, 5 bits/ch.
+ * intf[8] codec DMA: 4 interface, 5 port, 6 DMA index/channel mask.
+ * graph.u32 addresses a whole payload word by module, param and byte offset. */
+static void
+as_override_payload(uint32_t *p, unsigned words)
+{
+	for (unsigned i = 0; i < as_override_count; i++) {
+		as_override &o = as_overrides[i];
+		if (p[0] == o.module && p[1] == o.param && o.offset / 4 < words)
+			p[o.offset / 4] = o.value;
+	}
+}
+
+static void
+as_exec(unsigned section, const as_line &entry)
+{
+	char line[160], *a[7] = {}, *cursor;
+	strlcpy(line, entry.text, sizeof(line));
+	cursor = line;
+	unsigned n = 0;
+	while (*cursor && n < 7) {
+		while (*cursor == ' ' || *cursor == '\t') cursor++;
+		if (!*cursor || *cursor == '#') break;
+		a[n++] = cursor;
+		while (*cursor && *cursor != ' ' && *cursor != '\t') cursor++;
+		if (*cursor) *cursor++ = '\0';
+	}
+	const char *result = "bad args";
+	uint32_t x = 0, y = 0, z = 0, v = 0;
+	if (!n) return;
+	if (!strcmp(a[0], "log")) { LOG("as %s log -> %s", section == 1 ? "codec" : section == 2 ? "graph" : section == 3 ? "tone" : "stop", (strlen(entry.text) > 4 ? entry.text + 4 : "")); return; }
+	if (!strcmp(a[0], "delay") && n == 2 && as_num(a[1], &x) && x <= 1000) { IOSleep(x); result = "ok"; }
+	else if (!strcmp(a[0], "tone") && section == 1 && n == 5 && as_num(a[1], &x) && as_num(a[2], &y) && as_num(a[3], &z) &&
+	    x >= 20 && x <= 10000 && y >= 1 && y <= 30 && z <= 32767 &&
+	    (!strcmp(a[4], "L") || !strcmp(a[4], "R") || !strcmp(a[4], "LR"))) {
+		as_tone_hz = x; as_tone_secs = y; as_tone_amp = z;
+		as_tone_side = !strcmp(a[4], "L") ? 1 : !strcmp(a[4], "R") ? 2 : 3; result = "ok";
+	}
+	else if (!strncmp(a[0], "graph.", 6) && section == 2) {
+		if (!strcmp(a[0], "graph.u32") && n == 5 && as_num(a[1], &x) && as_num(a[2], &y) &&
+		    as_num(a[3], &z) && as_num(a[4], &v) && !(z & 3) && z >= 16 && z < 48 && as_override_count < 32) {
+			as_overrides[as_override_count++] = { x, y, z, v }; result = "ok";
+		} else if (n == 2 && as_num(a[1], &x)) {
+			if (!strcmp(a[0], "graph.intf") && x <= 3) as_graph_intf = x, result = "ok";
+			else if (!strcmp(a[0], "graph.port") && x <= 15) as_graph_port = x, result = "ok";
+			else if (!strcmp(a[0], "graph.rate") && x >= 8000 && x <= 192000) as_graph_rate = x, result = "ok";
+			else if (!strcmp(a[0], "graph.bits") && (x == 16 || x == 24 || x == 32)) as_graph_bits = x, result = "ok";
+			else if (!strcmp(a[0], "graph.channels") && x >= 1 && x <= 2) as_graph_channels = x, result = "ok";
+			else if (!strcmp(a[0], "graph.chmap") && x <= 0xffff) as_graph_chmap = x, result = "ok";
+			else if (!strcmp(a[0], "graph.dma_index") && x <= 15) as_graph_dma_index = x, result = "ok";
+		}
+	}
+	else if (n == 3 && as_num(a[1], &x) && as_num(a[2], &y)) {
+		if (!strcmp(a[0], "rx") && x <= 0x1fff && !(x & 3) && y <= 255 && lpass) lw(RX_MACRO + x, y), result = "ok";
+		else if ((!strcmp(a[0], "wcd") || !strcmp(a[0], "swrs")) && x <= 0xffff && y <= 255 && lpass)
+			swr_wr(!strcmp(a[0], "wcd") ? VA_SWR : RX_SWR, 1, x, y), result = "ok";
+		else if (!strcmp(a[0], "swr") && x <= 0x1ffc && !(x & 3) && lpass) lw(RX_SWR + x, y), result = "ok";
+		else if (!strcmp(a[0], "mmio") && as_mmio(x)) { *as_mmio_ptr(x) = y; mb(); result = "ok"; }
+	}
+	else if (!strcmp(a[0], "i2c") && n == 4 && as_num(a[1], &x) && as_num(a[2], &y) && as_num(a[3], &z) &&
+	    (x == 34 || x == 35) && y <= 255 && z <= 0xffff) result = sweet_i2c1_write16((uint8_t)(x + 0x12), (uint8_t)y, (uint16_t)z) ? "i2c error" : "ok";
+	else if (!strcmp(a[0], "rd") && (n == 3 || n == 4) && as_num(a[2], &x) &&
+	    (n == 3 || as_num(a[3], &y)) && (n == 3 || (y >= 1 && y <= 8))) {
+		unsigned count = n == 3 ? 1 : y;
+		char values[100] = "";
+		result = "ok";
+		for (unsigned i = 0; i < count; i++) {
+			uint32_t addr = x + i * ((!strcmp(a[1], "wcd") || !strcmp(a[1], "swrs") || !strcmp(a[1], "i2c34") || !strcmp(a[1], "i2c35")) ? 1 : 4);
+			uint32_t val = 0; bool ok = true;
+			if (!strcmp(a[1], "rx") && addr <= 0x1ffc && !(addr & 3) && lpass) val = lr(RX_MACRO + addr);
+			else if (!strcmp(a[1], "swr") && addr <= 0x1ffc && !(addr & 3) && lpass) val = lr(RX_SWR + addr);
+			else if ((!strcmp(a[1], "wcd") || !strcmp(a[1], "swrs")) && addr <= 0xffff && lpass) {
+				uint8_t b = 0; ok = swr_rd(!strcmp(a[1], "wcd") ? VA_SWR : RX_SWR, 1, addr, &b); val = b;
+			} else if ((!strcmp(a[1], "i2c34") || !strcmp(a[1], "i2c35")) && addr <= 255) {
+				uint16_t b = 0; ok = sapphire_fs_read(!strcmp(a[1], "i2c34") ? 0x34 : 0x35, addr, &b) == 0; val = b;
+			} else if (!strcmp(a[1], "mmio") && as_mmio(addr)) val = *as_mmio_ptr(addr);
+			else ok = false;
+			if (!ok) { result = "read error"; break; }
+			char word[13];
+			snprintf(word, sizeof(word), "%s%08x", i ? "," : "", val);
+			strlcat(values, word, sizeof(values));
+		}
+		LOG("as %s %.72s -> %s %s", section == 1 ? "codec" : section == 2 ? "graph" : section == 3 ? "tone" : "stop", entry.text, result, values);
+		return;
+	}
+	LOG("as %s %.90s -> %s", section == 1 ? "codec" : section == 2 ? "graph" : section == 3 ? "tone" : "stop", entry.text, result);
+}
+
+static void
+as_run(unsigned section, bool periodic = false, unsigned elapsed = 0)
+{
+	if (!as_enabled) return;
+	for (unsigned i = 0; i < as_count; i++) {
+		const as_line &e = as_lines[i];
+		if (e.section != section || (e.every != 0) != periodic) continue;
+		if (periodic) {
+			if (elapsed < as_due[i]) continue;
+			as_due[i] = elapsed + e.every;
+		}
+		as_exec(section, e);
+	}
+}
+
 /*
  * Graph SH_MEM_PULL_MODE (the DSP reads the ring itself) -> CODEC_DMA_SINK on RX_CODEC_DMA_RX_1
  * (AIF2_PB -> RX2 -> INT2 -> AUX), 48 kHz 16-bit stereo; TopazSpeaker HwStreamPrepare().
@@ -2638,16 +2854,23 @@ graph_open(uint64_t ring_pa, uint32_t ring_bytes, uint64_t pos_pa)
 		1, 0x08001003, 56, 0, 2, PULL, 1, 0x08001015, 8, 0, 1, DMA, 1, 0x08001015, 8, 1, 0, 0,
 		1, 0x08001004, 24, 0, 1, PULL, 1, DMA, 2, 0
 	};
-	const uint32_t ch = 2, rate = 48000;
-	uint32_t mf[12] = { PULL, 0x0800100C, 32, 0, 1, 0x09001000, 20, rate, 16 | (1u << 16), 16 | (15u << 16),
-		            1 | (ch << 16), 1 | (2u << 8) };
+	if (!as_graph_prepared) {
