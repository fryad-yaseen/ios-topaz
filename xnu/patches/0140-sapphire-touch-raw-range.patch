From 859e6ca6b0be3baf84d1c8426648afb84e1f5c0f Mon Sep 17 00:00:00 2001
From: x <x@x>
Date: Wed, 21 Oct 2026 21:21:20 +0300
Subject: [PATCH] sapphire-0140: FocalTech raw touch range as boot-args
 (sweettouchxmax/ymax), clamp instead of drop, raw max in stats

---
 bsd/dev/sweet_touch.c | 39 ++++++++++++++++++++++++++++++---------
 1 file changed, 30 insertions(+), 9 deletions(-)

diff --git a/bsd/dev/sweet_touch.c b/bsd/dev/sweet_touch.c
index ff9d858..b672a7a 100644
--- a/bsd/dev/sweet_touch.c
+++ b/bsd/dev/sweet_touch.c
@@ -94,6 +94,9 @@ static struct {
 	unsigned s_frames, s_errs, s_down, s_up, s_maxn;
 	int s_lasterr, s_lastx, s_lasty;
 	uint8_t s_raw[12];
+	unsigned s_rawxmax, s_rawymax;
+	/* FocalTech raw range (sweettouchxmax/ymax): topaz FT5452 1350x3000 */
+	unsigned xmax, ymax;
 } st;
 static int touch_sleep_chan;
 
@@ -530,12 +533,20 @@ touch_focaltech(void)
 		}
 		unsigned px = ((unsigned)(p[0] & 15u) << 8) | p[1];
 		unsigned py = ((unsigned)(p[2] & 15u) << 8) | p[3];
-		/* topaz: raw 0..1349 x 0..2999 (1.25x the panel) + 2-bit fractions */
-		if (px > 1349 || py > 2999) {
-			return EIO;
+		/*
+		 * Raw 0..xmax-1 x 0..ymax-1 + 2-bit fractions. topaz FT5452: 1350x3000
+		 * (1.25x the panel). sapphire FT3519T reports more (x 1620 seen), so
+		 * the range is a boot-arg and out-of-range points are clamped, not
+		 * dropped (dropping lost the bottom edge and the right side).
+		 */
+		if (px > st.s_rawxmax) {
+			st.s_rawxmax = px;
+		}
+		if (py > st.s_rawymax) {
+			st.s_rawymax = py;
 		}
-		px = (px * 4u + (p[4] >> 6)) / 5u;
-		py = (py * 4u + ((p[4] >> 4) & 3u)) / 5u;
+		px = (px * 4u + (p[4] >> 6)) * 1080u / (st.xmax * 4u);
+		py = (py * 4u + ((p[4] >> 4) & 3u)) * 2400u / (st.ymax * 4u);
 		px = px > 1079 ? 1079 : px;
 		py = py > 2399 ? 2399 : py;
 		mask |= 1u << id;
@@ -695,11 +706,12 @@ touch_thread(void *arg, wait_result_t result)
 	    goodix ? "GT9896 Yellowstone" : "Focaltech 54:52", st.irq_hint);
 	unsigned errors = 0, ticks = 0, polls = 0;
 	while (!st.dead) {
-		if (st.diag == 2 && ++polls == 3000) {  /* ~30 s at 10 ms */
-			panic("SWEET TOUCH stats: frames=%u errs=%u lasterr=%d maxn=%u hid down=%u up=%u last=%d,%d | "
-			    "raw %02x %02x %02x | %02x %02x %02x %02x %02x %02x | %02x %02x %02x",
+		/* ~30 s at 10 ms, counted from the first contact */
+		if (st.diag == 2 && st.s_down && ++polls == 3000) {
+			panic("SWEET TOUCH stats: frames=%u errs=%u lasterr=%d maxn=%u hid down=%u up=%u last=%d,%d "
+			    "rawmax=%u,%u range=%u,%u | raw %02x %02x %02x | %02x %02x %02x %02x %02x %02x | %02x %02x %02x",
 			    st.s_frames, st.s_errs, st.s_lasterr, st.s_maxn, st.s_down, st.s_up,
-			    st.s_lastx, st.s_lasty, st.s_raw[0], st.s_raw[1], st.s_raw[2],
+			    st.s_lastx, st.s_lasty, st.s_rawxmax, st.s_rawymax, st.xmax, st.ymax, st.s_raw[0], st.s_raw[1], st.s_raw[2],
 			    st.s_raw[3], st.s_raw[4], st.s_raw[5], st.s_raw[6], st.s_raw[7],
 			    st.s_raw[8], st.s_raw[9], st.s_raw[10], st.s_raw[11]);
 		}
@@ -749,6 +761,15 @@ sweet_touch_init(void)
 	st.irq_hint = 1; /* topaz: read on IRQ GPIO80 low, while touching, else every 100 ms */
 	(void)PE_parse_boot_argn("sweettouchirq", &st.irq_hint, sizeof(st.irq_hint));
 	(void)PE_parse_boot_argn("sweettouchdiag", &st.diag, sizeof(st.diag));
+	st.xmax = 1350;
+	st.ymax = 3000;
+	(void)PE_parse_boot_argn("sweettouchxmax", &st.xmax, sizeof(st.xmax));
+	(void)PE_parse_boot_argn("sweettouchymax", &st.ymax, sizeof(st.ymax));
+	if (st.xmax < 1080 || st.xmax > 4096 || st.ymax < 2400 || st.ymax > 4096) {
+		st.xmax = 1350;
+		st.ymax = 3000;
+	}
+	printf("SWEET TOUCH: raw range %ux%u\n", st.xmax, st.ymax);
 	if (!enabled) {
 		printf("SWEET TOUCH: disabled (sweettouch=0)\n");
 		return;
-- 
2.56.0

